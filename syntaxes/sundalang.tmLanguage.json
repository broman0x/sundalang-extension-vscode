{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "SundaLang",
  "scopeName": "source.sunda",
  "patterns": [
    {
      "name": "comment.line.double-slash.sunda",
      "match": "//.*$"
    },
    {
      "name": "comment.line.number-sign.sunda",
      "match": "#.*$"
    },
    {
      "name": "string.quoted.double.sunda",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.sunda",
          "match": "\\\\(n|t|r|\\\\|\")"
        }
      ]
    },
    {
      "name": "keyword.control.sunda",
      "match": "\\b(lamun|lamunteu|pikeun|kedap|eureun|tuluy|milih|kasus|baku|balik|balikkeun|cobaan|sanya|buka)\\b"
    },
    {
      "name": "storage.type.sunda",
      "match": "\\b(tanda|tetep|pungsi|fungsi|wadah)\\b"
    },
    {
      "name": "support.function.builtin.sunda",
      "match": "\\b(cetakkeun|tanyakeun|panjang|mimiti|tungtung|asupkeun|garede|laleutik|kana_angka|kana_tulisan|tipe|waktu|acak|sare|reureuh|maca|nyerat)\\b"
    },
    {
      "name": "constant.language.boolean.sunda",
      "match": "\\b(bener|salah)\\b"
    },
    {
      "name": "constant.language.null.sunda",
      "match": "\\b(ewehan)\\b"
    },
    {
      "name": "constant.numeric.integer.sunda",
      "match": "\\b\\d+\\b"
    },
    {
      "name": "keyword.operator.sunda",
      "match": "(\\+|\\-|\\*|\\/|%|==|!=|<|>|<=|>=|=|!|&&|\\|\\|)"
    },
    {
      "match": "\\b(pungsi|fungsi)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
      "captures": {
        "1": {
          "name": "storage.type.sunda"
        },
        "2": {
          "name": "entity.name.function.definition.sunda"
        }
      }
    },
    {
      "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*\\(",
      "captures": {
        "1": {
          "name": "entity.name.function.sunda"
        }
      }
    }
  ]
}